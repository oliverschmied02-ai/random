[gd_scene load_steps=4 format=3]

[ext_resource type="Script" path="res://ui/pause_menu.gd" id="1_pause"]
[ext_resource type="AudioStream" path="res://audio/klick.wav" id="2_klick"]

[sub_resource type="StyleBoxFlat" id="StyleBoxFlat_panel"]
bg_color = Color(0.0627451, 0.0666667, 0.0862745, 0.921569)
corner_radius_top_left = 12
corner_radius_top_right = 12
corner_radius_bottom_right = 12
corner_radius_bottom_left = 12

[node name="PauseMenu" type="CanvasLayer"]
layer = 40
script = ExtResource("1_pause")

[node name="Wurzel" type="Control" parent="."]
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0

[node name="Schleier" type="ColorRect" parent="Wurzel"]
